  "values": {
    "fishofthieves:coconut_fruit_growable_log": {
      "transform_data": {
        "block_state_provider": {
          "type": "minecraft:rule_based",
          "rules": [
            {
              "if_true": {
                "type": "minecraft:matching_blocks",
                "blocks": "fishofthieves:coconut_fruit_growable_log"
              },
              "then": {
                "type": "minecraft:copy_properties",
                "source": {
                  "id": "fishofthieves:stripped_small_coconut_log",
                  "properties": {
                    "axis": "y",
                    "waterlogged": "false"
                  }
                }
              }
            }
          ]
        },
        "item_damage_per_use": 1,
        "sound": "minecraft:item.axe.strip"
      },
      "transformer": "minecraft:axe"
    },
