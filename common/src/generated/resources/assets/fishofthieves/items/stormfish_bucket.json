{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/ancient_stormfish_bucket"
        },
        "when": "fishofthieves:ancient"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/shores_stormfish_bucket"
        },
        "when": "fishofthieves:shores"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/wild_stormfish_bucket"
        },
        "when": "fishofthieves:wild"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/shadow_stormfish_bucket"
        },
        "when": "fishofthieves:shadow"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/twilight_stormfish_bucket"
        },
        "when": "fishofthieves:twilight"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/starshine_stormfish_bucket"
        },
        "when": "fishofthieves:starshine"
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "fishofthieves:item/ancient_stormfish_bucket"
    },
    "property": "fishofthieves:stormfish_variant"
  }
}