{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/stone_islehopper_bucket"
        },
        "when": "fishofthieves:stone"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/moss_islehopper_bucket"
        },
        "when": "fishofthieves:moss"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/honey_islehopper_bucket"
        },
        "when": "fishofthieves:honey"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/raven_islehopper_bucket"
        },
        "when": "fishofthieves:raven"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/amethyst_islehopper_bucket"
        },
        "when": "fishofthieves:amethyst"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/briny_islehopper_bucket"
        },
        "when": "fishofthieves:briny"
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "fishofthieves:item/stone_islehopper_bucket"
    },
    "property": "fishofthieves:islehopper_variant"
  }
}