{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/almond_ancientscale"
        },
        "when": {
          "ancientscale_variant": "fishofthieves:almond"
        }
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/sapphire_ancientscale"
        },
        "when": {
          "ancientscale_variant": "fishofthieves:sapphire"
        }
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/smoke_ancientscale"
        },
        "when": {
          "ancientscale_variant": "fishofthieves:smoke"
        }
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/bone_ancientscale"
        },
        "when": {
          "ancientscale_variant": "fishofthieves:bone"
        }
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/starshine_ancientscale"
        },
        "when": {
          "ancientscale_variant": "fishofthieves:starshine"
        }
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/blossom_ancientscale"
        },
        "when": {
          "ancientscale_variant": "fishofthieves:blossom"
        }
      }
    ],
    "component": "minecraft:custom_data",
    "fallback": {
      "type": "minecraft:model",
      "model": "fishofthieves:item/almond_ancientscale"
    },
    "property": "minecraft:component"
  }
}