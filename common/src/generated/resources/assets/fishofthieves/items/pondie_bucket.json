{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/charcoal_pondie_bucket"
        },
        "when": "fishofthieves:charcoal"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/orchid_pondie_bucket"
        },
        "when": "fishofthieves:orchid"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/bronze_pondie_bucket"
        },
        "when": "fishofthieves:bronze"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/bright_pondie_bucket"
        },
        "when": "fishofthieves:bright"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/moonsky_pondie_bucket"
        },
        "when": "fishofthieves:moonsky"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/dewdrop_pondie_bucket"
        },
        "when": "fishofthieves:dewdrop"
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "fishofthieves:item/charcoal_pondie_bucket"
    },
    "property": "fishofthieves:pondie_variant"
  }
}