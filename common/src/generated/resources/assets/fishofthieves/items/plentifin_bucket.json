{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/olive_plentifin_bucket"
        },
        "when": "fishofthieves:olive"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/amber_plentifin_bucket"
        },
        "when": "fishofthieves:amber"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/cloudy_plentifin_bucket"
        },
        "when": "fishofthieves:cloudy"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/bonedust_plentifin_bucket"
        },
        "when": "fishofthieves:bonedust"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/watery_plentifin_bucket"
        },
        "when": "fishofthieves:watery"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/crimson_plentifin_bucket"
        },
        "when": "fishofthieves:crimson"
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "fishofthieves:item/olive_plentifin_bucket"
    },
    "property": "fishofthieves:plentifin_variant"
  }
