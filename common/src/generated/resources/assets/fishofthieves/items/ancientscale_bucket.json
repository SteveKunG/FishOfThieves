{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/almond_ancientscale_bucket"
        },
        "when": "fishofthieves:almond"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/sapphire_ancientscale_bucket"
        },
        "when": "fishofthieves:sapphire"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/smoke_ancientscale_bucket"
        },
        "when": "fishofthieves:smoke"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/bone_ancientscale_bucket"
        },
        "when": "fishofthieves:bone"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/starshine_ancientscale_bucket"
        },
        "when": "fishofthieves:starshine"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "fishofthieves:item/blossom_ancientscale_bucket"
        },
        "when": "fishofthieves:blossom"
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "fishofthieves:item/almond_ancientscale_bucket"
    },
    "property": "fishofthieves:ancientscale_variant"
  }
}