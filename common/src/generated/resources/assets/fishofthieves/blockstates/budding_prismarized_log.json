{
  "multipart": [
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_horizontal",
        "x": 90
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_horizontal",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_top",
        "uvlock": true,
        "x": 90
      },
      "when": {
        "axis": "y",
        "bud": "false"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_budding",
        "uvlock": true,
        "x": 90
      },
      "when": {
        "axis": "y",
        "bud": "true"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_side",
        "uvlock": false,
        "x": 90
      },
      "when": {
        "axis": "z",
        "bud": "false"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_side",
        "uvlock": false,
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "bud": "false"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_budding",
        "uvlock": false,
        "x": 90
      },
      "when": {
        "axis": "z",
        "bud": "true"
      }
    },
    {
      "apply": {
        "model": "fishofthieves:block/budding_prismarized_log_budding",
        "uvlock": false,
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "bud": "true"
      }
    }
  ]
}