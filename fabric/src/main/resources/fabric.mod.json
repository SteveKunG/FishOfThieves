{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${mod_description}",
  "authors": [
    "SteveKunG",
    "PloyiinGz",
    "Gucc1Guy"
  ],
  "icon": "logo.png",
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/fish-of-thieves",
    "sources": "https://github.com/SteveKunG/FishOfThieves",
    "issues": "https://github.com/SteveKunG/FishOfThieves/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.stevekung.fishofthieves.fabric.FishOfThievesFabric"
    ],
    "client": [
      "com.stevekung.fishofthieves.fabric.FishOfThievesFabricClient"
    ],
    "fabric-datagen": [
      "com.stevekung.fishofthieves.fabric.datagen.FOTDataGeneratorEntrypoint"
    ],
    "modmenu": [
      "com.stevekung.fishofthieves.fabric.modmenu.ModMenuIntegration"
    ],
    "terrablender": [
      "com.stevekung.fishofthieves.fabric.terrablender.FishOfThievesTerraBlenderFabric"
    ],
    "mm:early_risers": [
      "com.stevekung.fishofthieves.fabric.asm.EarlyRisers"
    ]
  },
  "mixins": [
    "mixins.fish_of_thieves.json",
    "mixins.fish_of_thieves_fabric.json"
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": ">=0.144",
    "cloth-config": ">=26.1",
    "minecraft": "~26.1"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/4bAj4mkGag"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/LivingEntity": [
        "com/stevekung/fishofthieves/entity/PartyFish"
      ],
      "net/minecraft/world/damagesource/DamageSources": [
        "com/stevekung/fishofthieves/damagesource/FOTDamageSources"
      ],
      "net/minecraft/client/renderer/entity/state/LivingEntityRenderState": [
        "com/stevekung/fishofthieves/client/renderer/entity/state/LivingEntityRenderStateExtender"
      ],
      "net/minecraft/world/entity/Entity": [
        "com/stevekung/fishofthieves/client/entity/FishPlaqueDisplay"
      ],
      "net/minecraft/world/level/storage/loot/entries/LootPoolSingletonContainer\u0024Builder": [
        "com/stevekung/fishofthieves/loot/function/LootPoolSingletonContainerWeightAdder"
      ],
      "net/minecraft/world/entity/projectile/FishingHook": [
        "com/stevekung/fishofthieves/entity/FishingHookBait"
      ],
      "net/minecraft/server/level/ServerLevel": [
        "com/stevekung/fishofthieves/storage/BaitStorageAccessor"
      ],
      "net/minecraft/client/renderer/entity/state/FishingHookRenderState": [
        "com/stevekung/fishofthieves/client/renderer/entity/state/FishingHookRenderStateExtender"
      ],
      "net/minecraft/world/entity/variant/SpawnContext": [
        "com/stevekung/fishofthieves/entity/condition/SpawnContextExtender"
      ]
    }
  }
}